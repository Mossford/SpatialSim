#version 450

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform image2D texture;
layout(set = 1, binding = 0) uniform UniformBufferObject 
{
    uint colorTex;
} ubo;

void main()
{
    vec3 pixel = vec3(gl_GlobalInvocationID.x / 64.0, gl_GlobalInvocationID.y / 64.0, 0);
    imageStore(texture, ivec2(gl_GlobalInvocationID.xy), vec4(pixel, 0));
}
